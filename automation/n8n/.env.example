# =============================================================================
# Berserker / Automation / n8n Environment Configuration
# =============================================================================

# Port on which n8n listens (default: 5678)
N8N_PORT=5678

# Webhook and host access URL
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Timezone
GENERIC_TIMEZONE=UTC

# Logging
N8N_LOG_LEVEL=info

# Berserker Local llama-server endpoint reference
# In host network mode: http://127.0.0.1:8080/v1
# In bridge network mode: http://host.docker.internal:8080/v1
LLAMA_SERVER_ENDPOINT=http://127.0.0.1:8080/v1
LLAMA_SERVER_MODEL=qwen36-coder
