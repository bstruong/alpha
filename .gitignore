results/
benchmarks/qwen36-daily/library/config/master.key
benchmarks/qwen36-daily/library/storage/*.sqlite3
benchmarks/qwen36-daily/library/tmp/
benchmarks/qwen36-daily/library/log/*.log
bench_*.txt
*.log
__pycache__/
.aider*.history*
aider-test/

# llm-benchmark generated fixtures (keep the dir, ignore contents)
llm-benchmark/fixtures/*
!llm-benchmark/fixtures/.gitkeep

# Convention: disposable/regenerable working output lives in results/ (or a
# similarly-named per-project dir, e.g. ab-results/) and stays ignored above.
# Permanent deliverables -- final reports, appendices, anything meant to be
# read later rather than regenerated -- live in each project's reports/
# folder instead, which no rule here ever covers. See CONVENTIONS.md.

# Local LLM model weights and test cache
*.gguf
experiments/models/
.pytest_cache/

experiments/ai-evals-rails/

# Flash eval / local engine noise
experiments/hyperbolic-time-chamber/
experiments/llama.cpp-qwen4exp/
engine/run/*.pid
engine/run/slots/
scripts/__pycache__/
tests/**/__pycache__/
