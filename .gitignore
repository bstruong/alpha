# Alpha / Rails
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep
/public/assets
.byebug_history
/config/master.key
/db/*.sqlite3
/db/*.sqlite3-*

# Regenerable Alpha run output (permanent write-ups live in reports/ — see CONVENTIONS.md)
/results/*
!/results/.gitkeep
results/
*.log
bench_*.txt
__pycache__/
.pytest_cache/
.aider*.history*
aider-test/

# Scenario library local state (seed scenario under scenarios/qwen36-daily)
scenarios/qwen36-daily/library/config/master.key
scenarios/qwen36-daily/library/storage/*.sqlite3
scenarios/qwen36-daily/library/tmp/
scenarios/qwen36-daily/library/log/*.log

# Local LLM weights / engine runtime
*.gguf
engine/run/*.pid
engine/run/slots/

# Archived trees may still contain regenerable noise
archive/**/__pycache__/
archive/**/results/
archive/benchmarks-legacy/experiments/models/
archive/benchmarks-legacy/experiments/llama.cpp-qwen4exp/
archive/benchmarks-legacy/experiments/hyperbolic-time-chamber/
archive/benchmarks-legacy/experiments/ai-evals-rails/
archive/benchmarks-legacy/llm-benchmark/fixtures/*
!archive/benchmarks-legacy/llm-benchmark/fixtures/.gitkeep
