diff --git a/app/models/user.rb b/app/models/user.rb
index 4829eaf..3e791fc 100644
--- a/app/models/user.rb
+++ b/app/models/user.rb
@@ -24,11 +24,62 @@ class User < ApplicationRecord
     end
   end
 
+  def erase
+    transaction do
+      # Collect all email addresses associated with this user (original + deactivated)
+      email_addresses = [email_address]
+
+      if active?
+        # For active users: also collect the deactivated email format
+        email_addresses << deactived_email_address
+      else
+        # For deactivated users: also collect the original email format (before deactivation)
+        email_addresses << original_email_address_from_deactivated
+      end
+
+      # Delete sessions
+      sessions.delete_all
+
+      # Delete sign-in events for all associated email addresses
+      SignInEvent.where(email_address: email_addresses).delete_all
+
+      # Delete reading marks (destroy_all to avoid nullify issue)
+      reading_marks.destroy_all
+
+      # Delete accesses
+      accesses.delete_all
+
+      # Handle books created by this user
+      created_books.find_each do |book|
+        if book.everyone_access?
+          # Keep the book but remove the creator attribution
+          book.update!(creator_id: nil, author: "Deleted author")
+        else
+          # Delete private books
+          book.destroy
+        end
+      end
+
+      # Delete the user record
+      destroy
+    end
+  end
+
   private
     def deactived_email_address
       email_address&.gsub(/@/, "-deactivated-#{SecureRandom.uuid}@")
     end
 
+    def original_email_address_from_deactivated
+      # Reconstruct the original email from the deactivated format
+      # e.g., "alice-deactivated-<anything>@example.com" -> "alice@example.com"
+      if match = email_address&.match(/^(.+)-deactivated-[^@]+@(.+)$/i)
+        "#{match[1]}@#{match[2]}"
+      else
+        nil
+      end
+    end
+
     def grant_access_to_everyone_books
       all_accesses = Book.with_everyone_access.ids.collect { |id| { book_id: id, level: :reader } }
       accesses.insert_all(all_accesses)
