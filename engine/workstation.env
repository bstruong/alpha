# =============================================================================
# alpha / engine / workstation.env
# Environment defaults for Project Alpha local AI engine (llama-server)
# =============================================================================

# Base repository and directories
REPO="/home/brian/Projects/alpha"
MODELS_DIR="${REPO}/experiments/models"
MODELS_INI="${REPO}/engine/models.ini"

# Server networking
HOST="127.0.0.1"
PORT="8080"

# Default preset (options: qwen36-coder, qwen36-coder-hybrid, glm47-reap)
DEFAULT_PRESET="qwen36-coder-hybrid"

# Runtime files: logs, pid files
RUN_DIR="${REPO}/engine/run"
LOG_DIR="${REPO}/engine/run"

# Binary paths
# Custom build (commit 4d756bc+) with qwen4exp / Qwen3.8-Flash-Next support.
# System package llama.cpp-cuda b10631 lacks LLM_ARCH_QWEN4EXP.
LLAMA_SERVER_BIN="/home/brian/Projects/alpha/experiments/llama.cpp-qwen4exp/build/bin/llama-server"
PYTHON_BIN="/usr/bin/python3"
