[Unit]
Description=Project Alpha local AI engine (llama-server)
Documentation=https://github.com/bstruong/alpha
After=network.target

[Service]
Type=exec
WorkingDirectory=%h/projects/alpha
EnvironmentFile=-%h/projects/alpha/engine/workstation.env
Environment="LD_LIBRARY_PATH=%h/projects/alpha/experiments/llama.cpp-qwen4exp/build/bin:/usr/local/cuda-13.4/lib64"
ExecStart=%h/projects/alpha/engine/bin/llama-up.sh single ${DEFAULT_PRESET} --foreground
Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
KillMode=process
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
