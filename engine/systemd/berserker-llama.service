[Unit]
Description=hybrid-ai-harness llama-server local AI engine (Workstation)
Documentation=https://github.com/bstruong/berserker
After=network.target

[Service]
Type=exec
WorkingDirectory=/home/brian/Projects/berserker
EnvironmentFile=-/home/brian/Projects/berserker/engine/workstation.env
ExecStart=/home/brian/Projects/berserker/engine/bin/llama-up.sh single ${DEFAULT_PRESET} --foreground
Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
KillMode=process
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
