[Unit]
Description=Berserker llama-server local AI engine (Metrotower)
Documentation=https://github.com/bstruong/berserker
After=network.target

[Service]
Type=exec
WorkingDirectory=/home/brian/Projects/berserker
EnvironmentFile=-/home/brian/Projects/berserker/engine/metrotower.env
ExecStart=/home/brian/Projects/berserker/engine/bin/llama-up.sh single qwen36-coder --foreground
Restart=on-failure
RestartSec=5s
LimitMEMLOCK=infinity
KillMode=process
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
