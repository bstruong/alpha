# llama3.1-agent:8b — tuned for the miniswen agent loop.
# Base pull (llama3.1:8b) is left untouched.
#
# Chosen because it is the first candidate to actually populate the OpenAI
# tool_calls field on this Ollama build (0.32.15). qwen2.5-coder:14b advertised
# Capabilities: tools but always echoed the call as plain text instead.

FROM llama3.1:8b

# Ollama defaults to num_ctx 4096, which truncates nearly every task in the
# ai-evals corpus (miniswen never trims history, so context grows monotonically
# with accumulated bash output). 24576 is safe for an 8B-class model on a 12GB
# 3060 — the ~4.9GB weight footprint leaves ample room for the KV cache, unlike
# the 14B Q4_K_M which spilled 34% to CPU at this context size.
# Model's native context is 131072, so this is well within range.
PARAMETER num_ctx 24576

# Ollama defaults to temperature 0.8. Lower is more reliable for emitting
# well-formed tool-call JSON, which miniswen requires on every single turn.
PARAMETER temperature 0.2

# NOTE: the base model's three stop tokens (<|start_header_id|>,
# <|end_header_id|>, <|eot_id|>) are inherited via FROM and must not be removed.
